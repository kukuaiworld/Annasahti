# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Client aliases
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Google Maps Platform (Maps JavaScript, Geocoding, Routes APIs)
# Browser key: restrict to HTTP referrer (e.g. http://localhost:3000/*) with Maps JavaScript API enabled
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-api-key
# Server key: restrict to backend IP/server environment with Geocoding and Routes APIs enabled
GOOGLE_MAPS_API_KEY=your-google-maps-server-api-key
