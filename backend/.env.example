# ==========================================
# FoodLoop Backend - Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# CORS: comma-separated list of allowed browser origins (leave empty to disable cross-origin requests)
# http://localhost:3000 is the Next.js frontend in local development
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Database (with PostGIS)
# Host access (from laptop): localhost:5433 -> maps to container 5432
# Container-to-container access: postgres:5432
POSTGRES_USER=foodloop
POSTGRES_PASSWORD=foodloop_dev_password
POSTGRES_DB=foodloop
POSTGRES_PORT=5433
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_URL=postgresql://foodloop:foodloop_dev_password@localhost:5433/foodloop?schema=public
# TLS: DATABASE_SSL=true enables TLS; set DATABASE_SSL_REJECT_UNAUTHORIZED=false
# ONLY for local self-signed certificates - never for production.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Redis
# Host access (from laptop): localhost:6380 -> maps to container 6379
# Container-to-container access: redis:6379
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Supabase Authentication (P0 Security)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Google Maps Platform (Server-side Geocoding and Routes API)
# Restrict by server IP / API restriction (Geocoding API, Routes API)
GOOGLE_MAPS_API_KEY=your-google-maps-server-api-key

