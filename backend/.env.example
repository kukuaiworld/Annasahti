# ==========================================
# FoodLoop Backend - Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Database (with PostGIS)
# Host access (from laptop): localhost:5433 -> maps to container 5432
# Container-to-container access: postgres:5432
POSTGRES_USER=foodloop
POSTGRES_PASSWORD=foodloop_dev_password
POSTGRES_DB=foodloop
POSTGRES_PORT=5433
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_URL=postgresql://foodloop:foodloop_dev_password@localhost:5433/foodloop?schema=public

# Redis
# Host access (from laptop): localhost:6380 -> maps to container 6379
# Container-to-container access: redis:6379
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
